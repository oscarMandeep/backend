    "/v1/skills/search": {
      "get": {
        "operationId": "searchSkills",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "schema": {
              "example": "exel",
              "type": "string"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 20,
              "default": 8,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SkillRefDto"
                  }
                }
              }
            }
          }
        },
        "tags": [
          "skills"
        ]
      }
    },
    "/v1/skills": {
      "post": {
        "operationId": "createSkill",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateSkillDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SkillRefDto"
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "skills"
        ]
      }
    },
    "/v1/discover": {
      "get": {
        "operationId": "getDiscover",
        "parameters": [
          {
            "name": "mode",
            "required": false,
            "in": "query",
            "description": "ONLINE or IN_PERSON keeps people who can do that; BOTH or omitted keeps everyone",
            "schema": {
              "$ref": "#/components/schemas/Mode"
            }
          },
          {
            "name": "swapOnly",
            "required": false,
            "in": "query",
            "description": "Only two-way swaps (no credit matches)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 50,
              "default": 20,
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DeckCardDto"
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "tags": [
          "discover"
        ]
      }
    },
