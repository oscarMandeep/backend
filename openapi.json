  "info": {
    "title": "SkillSwap API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SocketTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 60
          }
        },
        "required": [
          "token",
          "expiresIn"
        ]
      },
      "DevLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@skillswap.dev"
          }
        },
        "required": [
          "email"
        ]
      },
      "SkillRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "category"
        ]
      },
      "CreateSkillDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "exel formulas"
          }
        },
        "required": [
          "name"
        ]
      },
      "Mode": {
        "type": "string",
        "enum": [
          "ONLINE",
          "IN_PERSON",
          "BOTH"
        ]
      },
      "HaveDto": {
        "type": "object",
        "properties": {
          "skill": {
            "$ref": "#/components/schemas/SkillRefDto"
          },
          "level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "skill",
          "level",
          "verified"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ]
      },
      "WantDto": {
        "type": "object",
        "properties": {
          "skill": {
            "$ref": "#/components/schemas/SkillRefDto"
          },
          "goalLevel": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          }
        },
        "required": [
          "skill",
          "goalLevel",
          "priority"
        ]
      },
      "UserCardDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Mode"
              }
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ratingAvg": {
            "type": "number"
          },
          "ratingCount": {
            "type": "number"
          },
          "sessionsDone": {
            "type": "number"
          },
          "isNew": {
            "type": "boolean"
          },
          "haves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HaveDto"
            }
          },
          "wants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WantDto"
            }
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "mode",
          "languages",
          "ratingAvg",
          "ratingCount",
          "sessionsDone",
          "isNew",
          "haves",
          "wants"
        ]
      },
      "MatchKind": {
        "type": "string",
        "enum": [
          "SWAP",
          "CREDIT"
        ]
      },
      "MatchBreakdownDto": {
        "type": "object",
        "properties": {
          "skill": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reciprocity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "priority": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "availability": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "mode": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "language": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "trust": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "skill",
          "reciprocity",
          "priority",
          "availability",
          "mode",
          "language",
          "trust"
        ]
      },
      "DeckCardDto": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/UserCardDto"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "type": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MatchKind"
              }
            ]
          },
          "breakdown": {
            "$ref": "#/components/schemas/MatchBreakdownDto"
          },
          "reasons": {
            "example": [
              "Teaches Excel (you want)",
              "6 shared hrs/week"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "learnSkill": {
            "description": "What they can teach me",
            "allOf": [
              {
                "$ref": "#/components/schemas/SkillRefDto"
              }
            ]
          },
          "teachSkill": {
            "nullable": true,
            "description": "What I can teach them",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/SkillRefDto"
              }
            ]
          }
        },
        "required": [
          "user",
          "score",
          "type",
          "breakdown",
          "reasons",
          "learnSkill",
          "teachSkill"
        ]
      },
      "AvailabilitySlotDto": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "number",
            "minimum": 0,
            "maximum": 6,
            "description": "0 = Sunday"
          },
          "startMin": {
            "type": "number",
            "minimum": 0,
            "maximum": 1439,
            "description": "Minutes from midnight"
          },
          "endMin": {
            "type": "number",
            "minimum": 1,
            "maximum": 1440
          }
        },
        "required": [
          "dayOfWeek",
          "startMin",
          "endMin"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Mode"
              }
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ratingAvg": {
            "type": "number"
          },
          "ratingCount": {
            "type": "number"
          },
          "sessionsDone": {
            "type": "number"
          },
          "isNew": {
            "type": "boolean"
          },
          "haves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HaveDto"
            }
          },
          "wants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WantDto"
            }
          },
          "email": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "credits": {
            "type": "number"
          },
          "onboarded": {
            "type": "boolean"
          },
          "isPublic": {
            "type": "boolean"
          },
          "availability": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlotDto"
            }
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "mode",
          "languages",
          "ratingAvg",
          "ratingCount",
          "sessionsDone",
          "isNew",
          "haves",
          "wants",
          "email",
          "timezone",
          "credits",
          "onboarded",
          "isPublic",
          "availability"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Riya Sharma"
          },
          "username": {
            "type": "string",
            "example": "riya_s",
            "description": "3-20 lowercase letters, digits or _"
          },
          "bio": {
            "type": "string",
            "description": "Empty string clears it"
          },
          "city": {
            "type": "string",
            "example": "Dehradun",
            "description": "Empty string clears it"
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Mode"
              }
            ]
          },
          "languages": {
            "example": [
              "English",
              "Hindi"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timezone": {
            "type": "string",
            "example": "Asia/Kolkata"
          },
          "isPublic": {
            "type": "boolean"
          },
          "avatarUrl": {
            "type": "string",
            "example": "https://res.cloudinary.com/demo/avatar.jpg"
          }
        }
      },
      "HaveInputDto": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string"
          },
          "level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "years": {
            "type": "number",
            "minimum": 0,
            "maximum": 60
          },
          "proofUrl": {
            "type": "string"
          }
        },
        "required": [
          "skillId",
          "level"
        ]
      },
      "WantInputDto": {
        "type": "object",
        "properties": {
          "skillId": {
            "type": "string"
          },
          "currentLevel": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "goalLevel": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          }
        },
        "required": [
          "skillId",
          "currentLevel",
          "goalLevel",
          "priority"
        ]
      },
      "UpdateSkillsDto": {
        "type": "object",
        "properties": {
          "haves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HaveInputDto"
            }
          },
          "wants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WantInputDto"
            }
          }
        },
        "required": [
          "haves",
          "wants"
        ]
      },
      "UpdateAvailabilityDto": {
        "type": "object",
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlotDto"
            }
          }
        },
        "required": [
          "slots"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
