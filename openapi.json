  },
  "info": {
    "title": "SkillSwap API",
    "description": "",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "SocketTokenResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "example": 60
          }
        },
        "required": [
          "token",
          "expiresIn"
        ]
      },
      "DevLoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "demo@skillswap.dev"
          }
        },
        "required": [
          "email"
        ]
      },
      "Mode": {
        "type": "string",
        "enum": [
          "ONLINE",
          "IN_PERSON",
          "BOTH"
        ]
      },
      "SkillRefDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "category"
        ]
      },
      "HaveDto": {
        "type": "object",
        "properties": {
          "skill": {
            "$ref": "#/components/schemas/SkillRefDto"
          },
          "level": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "verified": {
            "type": "boolean"
          }
        },
        "required": [
          "skill",
          "level",
          "verified"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": [
          "HIGH",
          "MEDIUM",
          "LOW"
        ]
      },
      "WantDto": {
        "type": "object",
        "properties": {
          "skill": {
            "$ref": "#/components/schemas/SkillRefDto"
          },
          "goalLevel": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ]
          }
        },
        "required": [
          "skill",
          "goalLevel",
          "priority"
        ]
      },
      "AvailabilitySlotDto": {
        "type": "object",
        "properties": {
          "dayOfWeek": {
            "type": "number",
            "minimum": 0,
            "maximum": 6,
            "description": "0 = Sunday"
          },
          "startMin": {
            "type": "number",
            "description": "Minutes from midnight"
          },
          "endMin": {
            "type": "number"
          }
        },
        "required": [
          "dayOfWeek",
          "startMin",
          "endMin"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "mode": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Mode"
              }
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ratingAvg": {
            "type": "number"
          },
          "ratingCount": {
            "type": "number"
          },
          "sessionsDone": {
            "type": "number"
          },
          "isNew": {
            "type": "boolean"
          },
          "haves": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HaveDto"
            }
          },
          "wants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WantDto"
            }
          },
          "email": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "credits": {
            "type": "number"
          },
          "onboarded": {
            "type": "boolean"
          },
          "isPublic": {
            "type": "boolean"
          },
          "availability": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AvailabilitySlotDto"
            }
          }
        },
        "required": [
          "id",
          "username",
          "name",
          "mode",
          "languages",
          "ratingAvg",
          "ratingCount",
          "sessionsDone",
          "isNew",
          "haves",
          "wants",
          "email",
          "timezone",
          "credits",
          "onboarded",
          "isPublic",
          "availability"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}
